{
  plugins = {
    # keep-sorted start

    actions-preview.enable = true; # Preview LSP actions
    fidget.enable = true; # Show what's going on
    markdown-preview.enable = true; # :MarkdownPreview
    nix-develop.enable = true; # :NixDevelop / :NixShell
    render-markdown.enable = true;
    roslyn.enable = true; # C# lsp
    typst-preview.enable = true; # Typst my beloved
    vim-suda.enable = true; # :SudaRead / :SudaWrite
    visual-whitespace.enable = true; # Visualize whitespaces in v mode
    web-devicons.enable = true; # many plugins rely on this
    whitespace.enable = true; # Show trailing whitespaces

    # keep-sorted end
  };
}
